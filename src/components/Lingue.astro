---
// Selettore di lingua: una pista con tre posizioni, la bandiera della lingua scelta riempie la pista fino alla pallina.
// Sono tre link veri (ogni lingua ha il suo indirizzo): senza JS funzionano come link normali; src/scripts/lingue.js aggiunge il trascinamento.
import { LINGUE, indirizzo, type Lingua } from '../i18n';
interface Props { lingua: Lingua; uid: string; }
const { lingua, uid } = Astro.props;
const base = import.meta.env.BASE_URL;
const cur = LINGUE.indexOf(lingua);
const sigla = { it: 'IT', en: 'EN', es: 'ES' };
---
<nav class="lang" aria-label="Lingua / Language / Idioma" data-cur={cur} style={`--i:${cur}`}>
	<span class="lang__flags" aria-hidden="true">
		<svg class="f-it" viewBox="0 0 3 2" preserveAspectRatio="none"><rect width="1" height="2" fill="#009246" /><rect x="1" width="1" height="2" fill="#fff" /><rect x="2" width="1" height="2" fill="#ce2b37" /></svg>
		<svg class="f-gb" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice"><clipPath id={`gbc-${uid}`}><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath><rect width="60" height="30" fill="#012169" /><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" /><path d="M0,0 L60,30 M60,0 L0,30" clip-path={`url(#gbc-${uid})`} stroke="#c8102e" stroke-width="4" /><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" /><path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6" /></svg>
		<svg class="f-es" viewBox="0 0 4 4" preserveAspectRatio="none"><rect width="4" height="1" fill="#aa151b" /><rect y="1" width="4" height="2" fill="#f1bf00" /><rect y="3" width="4" height="1" fill="#aa151b" /></svg>
	</span>
	{LINGUE.map((l, n) => <a class="lang__a" style={`--n:${n}`} href={indirizzo(l, base)} hreflang={l} lang={l} aria-current={l === lingua ? 'true' : 'false'}>{sigla[l]}</a>)}
	<span class="lang__knob" aria-hidden="true">{sigla[lingua]}</span>
</nav>
