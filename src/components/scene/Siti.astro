---
// I quattro lavori veri del portfolio dello studio (screenshot già usati lì).
import Quadro from '../Quadro.astro';
import osteomed from '../../assets/osteomed.png';
import gf from '../../assets/gf-motori.jpg';
import axpro from '../../assets/axpro.jpg';
import ananda from '../../assets/ananda.jpg';
const { c, n, tot, t } = Astro.props;
// Nome, link e immagine sono qui; riga e alt (nella lingua della pagina) in src/i18n, nello stesso ordine. Tecnologie e punteggio vengono da src/data/portfolio-projects.ts dello studio (Lighthouse 100 nelle 4 categorie).
const lavori = [
	{ nome: 'Osteomed', url: 'https://www.osteomedrc.it/', img: osteomed },
	{ nome: 'GF Motori', url: 'https://www.gfmotori.com/', img: gf },
	{ nome: 'Axpro Paintball', url: 'https://axpropaintball.com/', img: axpro },
	{ nome: 'Ananda Grejo', url: 'https://anandagrejo.netlify.app/', img: ananda },
];
---
<div class="pane p5">
	<div class="t" id="t5">{c.titolo}</div>
	<div id="fr5">
		{lavori.map((l, i) => <div class="fr"><a class="shot" href={l.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><Quadro src={l.img} alt={t.siti.lavori[i].alt} fx="liquid" /></a><a class="c5" href={l.url} target="_blank" rel="noopener"><b>{l.nome}</b><span>{t.siti.lavori[i].riga}</span><em>Lighthouse 100</em></a></div>)}
	</div>
	<div class="lab l1">{n} / {tot} · {t.siti.etichetta}</div><div class="lab l2"><span class="hov">{t.siti.passa}</span><span class="tch">{t.siti.tocco}</span></div>
	<p class="cp">{c.testo}</p>
</div>
