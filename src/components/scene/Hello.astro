---
const { c, n, tot, t } = Astro.props;
---
<div class="pane p1">
	<div class="doc">
		<div class="lab">{n} / {tot} · {c.quando}</div>
		<h2 id="t1" aria-label={c.titolo}>{c.titolo}</h2>
		<p id="t1b">{t.hello.documento}</p>
		<p><span class="fake-link" id="t1l">{t.hello.link}</span></p>
	</div>
	<p class="cp">{c.testo}</p>
</div>
