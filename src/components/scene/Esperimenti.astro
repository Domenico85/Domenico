---
// Sei esperimenti in due serie da tre (screenshot dal Lab dello studio, gli stessi del portfolio): la prima serie esce, entra la seconda.
import Quadro from '../Quadro.astro';
import slider from '../../assets/slider-image-effect.jpg';
import three from '../../assets/three-js-animation.jpg';
import coffee from '../../assets/starbucks-coffee.jpg';
import animal from '../../assets/animal-slider.jpg';
import soda from '../../assets/slider-fruit-soda.jpg';
import sky from '../../assets/skytracker.jpg';
const { c, n, tot, t } = Astro.props;
const schede = [
	{ k: 'a', src: slider, look: 'seppia' },
	{ k: 'b', src: three, look: 'seppia' },
	{ k: 'c', src: coffee, look: 'carta' },
	{ k: 'd', src: animal, look: 'seppia' },
	{ k: 'e', src: soda, look: 'carta' },
	{ k: 'f', src: sky, look: 'seppia' },
] as const;
---
<div class="pane p3">
	<div class="mq" id="mq" aria-hidden="true">{t.esperimenti.marquee}</div>
	{schede.map((s, i) => <div class={`fr ${s.k}`}><Quadro src={s.src} alt={t.esperimenti.alt[i]} look={s.look} /></div>)}
	<h2 class="g" data-split>{c.titolo}</h2>
	<p class="cp"><span class="lab">{n} / {tot} · {c.quando}</span><br />{c.testo}</p>
</div>
