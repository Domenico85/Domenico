---
import InfinityMark from '../InfinityMark.astro';
const { c, t } = Astro.props;
---
<div class="pane p6">
	<div>
		<div class="inf" id="inf"><InfinityMark width="100%" /></div>
		<h2 class="g" data-split>{t.oggi.titolo} <i>Loop Studio</i></h2>
		<div class="sig" id="sig">Domenico</div>
		<p>{c.testo}</p>
		<div class="links">
			<a class="btn pri" href="https://theloopstudio.org/" target="_blank" rel="noopener">{t.oggi.vaiAlloStudio}</a>
			<a class="btn" href="https://github.com/Domenico85" target="_blank" rel="noopener">{t.oggi.ilMioGithub}</a>
			<button class="btn" id="top-btn" type="button">{t.oggi.ricomincia}</button>
		</div>
	</div>
	<div class="fine">{t.oggi.crediti}</div>
</div>
