---
import Base from '../layouts/Base.astro';
import InfinityMark from '../components/InfinityMark.astro';
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
import Hello from '../components/scene/Hello.astro';
import Corso from '../components/scene/Corso.astro';
import Esperimenti from '../components/scene/Esperimenti.astro';
import React from '../components/scene/React.astro';
import Siti from '../components/scene/Siti.astro';
import Oggi from '../components/scene/Oggi.astro';
import { CAPITOLI, TRACCE, MUSICA_ATTESA } from '../data/capitoli';
import { GRUPPI, REPOS } from '../data/repos';

// una scena per capitolo, stesso `id`
const SCENE = { hello: Hello, corso: Corso, esperimenti: Esperimenti, react: React, siti: Siti, oggi: Oggi };
const dati = { base: import.meta.env.BASE_URL, capitoli: CAPITOLI, tracce: TRACCE, attesa: MUSICA_ATTESA, repos: REPOS, gruppi: GRUPPI };
const primo = REPOS[0].d.slice(0, 7).split('-').reverse().join('/');
---
<Base title="Domenico" description="Domenico, sviluppatore web. La mappa di quello che ho costruito, una repo alla volta.">
	<canvas id="gl"></canvas>
	<div id="cur" aria-hidden="true"><InfinityMark width="100%" /></div>

	<div id="gate">
		<div class="pre" role="img" aria-label="Caricamento in corso">
			<span class="pre__ring pre__ring--5"></span><span class="pre__ring pre__ring--4"></span><span class="pre__ring pre__ring--3"></span><span class="pre__ring pre__ring--2"></span>
			<div class="goo"><i></i></div><InfinityMark width="3.6rem" />
		</div>
		<div id="gnum">0<small>%</small></div>
		<div class="ask" id="ask"><button class="btn pri" data-snd="1" type="button">Entra con musica</button><button class="btn" data-snd="0" type="button">Senza musica</button></div>
	</div>

	<header class="top">
		<a href="https://theloopstudio.org/" target="_blank" rel="noopener" aria-label="Loop Studio"><InfinityMark width="1.6em" /><span>Loop Studio</span></a>
		<nav><button id="snd" type="button" aria-pressed="false">suono: off</button><a href="#story">Percorso</a></nav>
	</header>
	<div class="rule" id="rule" aria-hidden="true"><div class="stage" id="stage"></div><div class="year" id="yr">{CAPITOLI[0].anno}</div><div class="ticks"><i id="mk"></i></div></div>

	<main>
		<section class="hero" id="top">
			<div class="bg" id="hbg"><Image src={heroBg} alt="" widths={[900, 1600, 2400]} sizes="100vw" format="webp" quality={72} loading="eager" fetchpriority="high" /></div>
			<canvas id="cc" role="img" aria-label="Le mie repo come stelle, a gruppi: tocca una stella per andare al capitolo"></canvas>
			<div id="lbl" class="mono"></div>
			<div class="tag mono rv">REPO <b>{REPOS.length}</b><br />CAPITOLI <b>{CAPITOLI.length}</b><br />DAL <b>{primo}</b></div>
			<div class="ui"><h1 data-split id="h1">Ciao, sono <i>Domenico</i></h1><p class="sub rv">Ogni punto è un progetto. Si accendono a gruppi, per periodo. Clicca su uno: ti porto nel capitolo giusto.</p></div>
			<div class="gnav" id="gnav" role="group" aria-label="Gruppi di repo"></div>
			<div class="credit">foto: Unsplash</div><div class="cue" aria-hidden="true">scorri ↓</div>
		</section>

		<section id="story" aria-label="Il percorso">
			{CAPITOLI.map((c, i) => { const Scena = SCENE[c.id]; return <Scena c={c} n={String(i + 1).padStart(2, '0')} tot={String(CAPITOLI.length).padStart(2, '0')} />; })}
		</section>
	</main>

	<script is:inline id="app-data" type="application/json" set:html={JSON.stringify(dati)}></script>
	<script>import '../scripts/main.js';</script>
</Base>
